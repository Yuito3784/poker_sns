# Database
DATABASE_URL="postgresql://user:password@localhost:5432/poker_sns"

# JWT (generate a strong random secret: openssl rand -base64 64)
JWT_SECRET="change-me-to-a-secure-random-string"

# Server
PORT=4000

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Frontend URL (for password reset links)
FRONTEND_URL="http://localhost:3000"

# Mail: Resend API (recommended on Railway; HTTPS, no SMTP port)
# https://resend.com → API Keys. If set, SMTP_* are ignored for sending.
RESEND_API_KEY=
SMTP_FROM="noreply@pokersns.com"

# SMTP fallback (local MailHog, Gmail, etc.) when RESEND_API_KEY is not set
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
