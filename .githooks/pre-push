#!/usr/bin/env bash
# pre-push hook: Reject pushes from non-compliant branch names.
# Allowed: main, dev, feature/*, fix/*, hotfix/*
# See: .cursor/skills/git-workflow/SKILL.md

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ -z "$BRANCH" ]; then
  # Detached HEAD — allow (e.g. CI tag push)
  exit 0
fi

case "$BRANCH" in
  main|dev)
    ;;
  feature/*|fix/*|hotfix/*)
    ;;
  *)
    echo ""
    echo "ERROR: Branch name '${BRANCH}' does not follow the naming convention."
    echo ""
    echo "  Allowed patterns:"
    echo "    main, dev, feature/<name>, fix/<name>, hotfix/<name>"
    echo ""
    echo "  Please rename your branch:"
    echo "    git branch -m ${BRANCH} feature/<descriptive-name>"
    echo "    git branch -m ${BRANCH} fix/<descriptive-name>"
    echo ""
    exit 1
    ;;
esac
