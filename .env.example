# ==========================================================
# Poker SNS 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env
# ==========================================================

# ========== Database ==========
DB_PASSWORD=your_strong_db_password_here

# ========== Backend ==========
# 生成コマンド: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex_string

# URLs
# ローカル: 下記のまま / 本番（Railway）例:
#   API_URL=https://pokersns-production.up.railway.app
#   FRONTEND_URL=あなたの本番フロントURL（Vercel等）
#   CORS_ORIGINS=上記フロントURLと同じ
API_URL=https://yourdomain.com/api
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# ========== メール送信 ==========
# Railway 等では SMTP がブロックされることがあるため、Resend API を推奨（HTTPS で届く）
# https://resend.com → API Keys でキーを発行
RESEND_API_KEY=re_xxxx
SMTP_FROM=noreply@yourdomain.com

# （オプション）Resend を使わない場合の SMTP（ローカル MailHog 等）
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_xxxx

# ========== Google OAuth ==========
# https://console.cloud.google.com/ → API とサービス → 認証情報 → OAuth 2.0 クライアント ID（ウェブアプリ）
# 承認済みリダイレクト URI に登録: {API_URL}/auth/google/callback
# ローカル: http://localhost:3001/auth/google/callback
# 本番:     https://yourdomain.com/auth/google/callback
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# ========== LINE Login ==========
# https://developers.line.biz/ → プロバイダー → LINE Login チャネル作成
# コールバック URL に登録: {API_URL}/auth/line/callback
# ローカル: http://localhost:3001/auth/line/callback
# 本番:     https://pokersns-production.up.railway.app/auth/line/callback
LINE_CLIENT_ID=xxx
LINE_CLIENT_SECRET=xxx

# ========== X (Twitter) OAuth ==========
# https://developer.twitter.com/ → Projects & Apps → User authentication settings
# Callback URI に登録: {API_URL}/auth/x/callback
# ローカル: http://localhost:3001/auth/x/callback
# 本番:     https://yourdomain.com/auth/x/callback
# ※ xxx のままではログインできません。Developer Portal の Client ID / Secret を設定すること
X_CLIENT_ID=xxx
X_CLIENT_SECRET=xxx

# ========== Stripe ==========
# https://dashboard.stripe.com/
# Webhook URL に登録: https://yourdomain.com/api/subscriptions/webhook
# Webhook イベント: checkout.session.completed, customer.subscription.updated,
#                   customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
# 年間プラン (¥9,800/年) — Stripe Dashboard で作成した Price ID
STRIPE_ANNUAL_PRICE_ID=price_annual_xxx

# ========== AI Hand Analysis (Claude API) ==========
# https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-xxx

# ========== Error Notification Webhook ==========
# Slack or Discord webhook URL for error/audit notifications
# Slack: https://hooks.slack.com/services/XXX/YYY/ZZZ
# Discord: https://discord.com/api/webhooks/XXX/YYY
ERROR_WEBHOOK_URL=
SERVICE_NAME=poker-sns-backend

# ========== Frontend (ビルド時に埋め込まれる) ==========
# 本番: Nginx 経由で /api プレフィックスを使用
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ========== 特定商取引法に基づく表記（Stripe 審査用） ==========
# Stripe 審査で “住所・電話・連絡先受付時間” の記載が求められることがあります。
# 本番サイトに表示される値なので、実在の情報を設定してください。
NEXT_PUBLIC_TOKUSHOHO_BUSINESS_NAME=Poker SNS
NEXT_PUBLIC_TOKUSHOHO_OPERATOR_NAME=大原 唯人
NEXT_PUBLIC_TOKUSHOHO_ADDRESS=〒000-0000 東京都◯◯区◯◯ 1-2-3
NEXT_PUBLIC_TOKUSHOHO_PHONE=03-0000-0000
NEXT_PUBLIC_TOKUSHOHO_CONTACT_HOURS=平日 10:00〜18:00
NEXT_PUBLIC_TOKUSHOHO_SUPPORT_EMAIL=support@pokersns.com
NEXT_PUBLIC_TOKUSHOHO_SALES_URL=https://poker-sns.vercel.app/lp

# ========== Google Analytics 4 ==========
# https://analytics.google.com/ → 管理 → データストリーム → 測定ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ========== SNS Auto-Post (自動投稿) ==========
# トークン暗号化キー (32バイトランダム hex)
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_random_hex_string

# X (Twitter) API — 自動投稿用 (ログイン用とは別アプリ)
# https://developer.twitter.com/ → Projects & Apps
# プラン: Basic ($100/mo, 50K tweets/mo) 推奨
# スコープ: tweet.write tweet.read users.read
X_AUTOPOST_CLIENT_ID=
X_AUTOPOST_CLIENT_SECRET=

# YouTube Data API v3 — 自動投稿用
# https://console.cloud.google.com/ → API & Services
# quota: 10,000 units/day (upload=1600 units)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram Graph API — 自動投稿用
# https://developers.facebook.com/ → Instagram Graph API
# Business/Creator アカウント必須
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
