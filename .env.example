# ==========================================================
# Poker SNS 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env
# ==========================================================

# ========== Database ==========
DB_PASSWORD=your_strong_db_password_here

# ========== Backend ==========
# 生成コマンド: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex_string

# URLs（本番はドメインに変更）
API_URL=https://yourdomain.com/api
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# ========== SMTP (メール送信) ==========
# 推奨: Resend https://resend.com (無料 3,000通/月)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxx
SMTP_FROM=noreply@yourdomain.com

# ========== Google OAuth ==========
# https://console.cloud.google.com/ → 認証情報 → OAuth 2.0 クライアント ID
# コールバック URI に登録: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# ========== LINE Login ==========
# https://developers.line.biz/ → プロバイダー → チャネル作成
# コールバック URI に登録: https://yourdomain.com/api/auth/line/callback
LINE_CLIENT_ID=xxx
LINE_CLIENT_SECRET=xxx

# ========== X (Twitter) OAuth ==========
# https://developer.twitter.com/ → Projects & Apps → OAuth 2.0 設定
# コールバック URI に登録: https://yourdomain.com/api/auth/x/callback
# スコープ: tweet.read users.read
X_CLIENT_ID=xxx
X_CLIENT_SECRET=xxx

# ========== Stripe ==========
# https://dashboard.stripe.com/
# Webhook URL に登録: https://yourdomain.com/api/subscriptions/webhook
# Webhook イベント: checkout.session.completed, customer.subscription.updated,
#                   customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# ========== Frontend (ビルド時に埋め込まれる) ==========
# 本番: Nginx 経由で /api プレフィックスを使用
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ========== Google Analytics 4 ==========
# https://analytics.google.com/ → 管理 → データストリーム → 測定ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ========== SNS Auto-Post (自動投稿) ==========
# トークン暗号化キー (32バイトランダム hex)
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_random_hex_string

# X (Twitter) API — 自動投稿用 (ログイン用とは別アプリ)
# https://developer.twitter.com/ → Projects & Apps
# プラン: Basic ($100/mo, 50K tweets/mo) 推奨
# スコープ: tweet.write tweet.read users.read
X_AUTOPOST_CLIENT_ID=
X_AUTOPOST_CLIENT_SECRET=

# YouTube Data API v3 — 自動投稿用
# https://console.cloud.google.com/ → API & Services
# quota: 10,000 units/day (upload=1600 units)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram Graph API — 自動投稿用
# https://developers.facebook.com/ → Instagram Graph API
# Business/Creator アカウント必須
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
